<p>メモの一覧</p>
<!--メモの一覧を表示させる-->
<% if @memos.empty? %>
  <p>メモはありません</p>
<% else %>
  <ul>
    <% @memos.each do |id, memo| %>
      <li><a href="memos/<%= id %>"><%= h(memo['title']) %></a></li>
    <% end %>
  </ul>
<% end %>
<a href="/memos/new">
  <button>
    <label for="">新規メモ作成</label>
  </button>
</a>
